# HideOut Creatives Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hideout?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_this_with_a_secure_random_string_of_at_least_32_characters

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=182385611527-9spuovpp98nusnrsvh9fnts3vl4pn4u6.apps.googleusercontent.com
# Google OAuth Client Secret (Optional for public PKCE clients, recommended if configured in Google Cloud)
GOOGLE_CLIENT_SECRET=

# Allowed Admin Google Account Emails (comma-separated, case-insensitive)
ADMIN_EMAILS=shadowhacktech@gmail.com

# Allowed Redirect URIs for Google Sign-In (comma-separated)
ADMIN_REDIRECT_URIS=https://hideout-creatives.vercel.app/admin/,https://hideout-creatives.vercel.app/admin,http://localhost:5173/admin/,http://localhost:5173/admin

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://hideout-creatives.vercel.app,http://localhost:5173,http://localhost:3000

